#!/bin/bash
# Управление пользователями Hysteria 2
# Использование: hy2user <команда> [аргументы]

USERS_FILE="/etc/hysteria/users.txt"

# Цвета
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

generate_password() {
    # Генерируем надёжный пароль (28 символов)
    tr -dc 'A-Za-z0-9' </dev/urandom | head -c 28
}

check_users_file() {
    if [ ! -f "$USERS_FILE" ]; then
        echo -e "${RED}Файл ${USERS_FILE} не найден${NC}"
        exit 1
    fi
}

user_exists() {
    local username="$1"
    grep -qi -- "^${username}:" "$USERS_FILE"
}

valid_username() {
    [[ "$1" =~ ^[a-zA-Z0-9_-]+$ ]]
}

valid_password() {
    local pw="$1"
    # пароль не должен содержать ':' (разделитель) и пробельных символов
    [[ -n "$pw" && "$pw" != *:* && "$pw" != *[[:space:]]* ]]
}

add_user() {
    local username="$1"
    local password="$2"

    if [ -z "$username" ]; then
        echo -e "${RED}Использование: hy2user add <username> [password]${NC}"
        exit 1
    fi

    # Проверка имени
    if ! valid_username "$username"; then
        echo -e "${RED}Имя пользователя может содержать только буквы, цифры, _ и -${NC}"
        exit 1
    fi

    if user_exists "$username"; then
        echo -e "${RED}Пользователь '${username}' уже существует${NC}"
        exit 1
    fi

    if [ -z "$password" ]; then
        password=$(generate_password)
        echo -e "${YELLOW}Сгенерирован пароль: ${GREEN}${password}${NC}"
    elif ! valid_password "$password"; then
        echo -e "${RED}Пароль не должен содержать ':' или пробелы${NC}"
        exit 1
    fi

    # гарантируем перевод строки в конце файла (иначе запись склеится с последней строкой)
    if [ -s "$USERS_FILE" ] && [ -n "$(tail -c 1 "$USERS_FILE")" ]; then
        echo "" >> "$USERS_FILE"
    fi
    echo "${username}:${password}" >> "$USERS_FILE"
    echo -e "${GREEN}✓ Пользователь '${username}' успешно добавлен${NC}"
}

change_pass() {
    local username="$1"
    local password="$2"

    if [ -z "$username" ]; then
        echo -e "${RED}Использование: hy2user pass <username> [new_password]${NC}"
        exit 1
    fi

    if ! user_exists "$username"; then
        echo -e "${RED}Пользователь '${username}' не найден${NC}"
        exit 1
    fi

    if [ -z "$password" ]; then
        password=$(generate_password)
        echo -e "${YELLOW}Сгенерирован новый пароль: ${GREEN}${password}${NC}"
    elif ! valid_password "$password"; then
        echo -e "${RED}Пароль не должен содержать ':' или пробелы${NC}"
        exit 1
    fi

    # Заменяем строку безопасно через awk (пароль может содержать / & и т.д.)
    # Регистр имени не важен при поиске (как в auth.sh), сохраняем введённое имя
    tmpfile=$(mktemp) || exit 1
    awk -v user="$username" -v pass="$password" '
        BEGIN { lower_user = tolower(user) }
        {
            line = $0
            sub(/\r$/, "", line)
            # пропускаем комментарии/пустые как есть
            if (line ~ /^[[:space:]]*#/ || line ~ /^[[:space:]]*$/) { print line; next }
            n = index(line, ":")
            if (n > 0) {
                su = substr(line, 1, n - 1)
                if (tolower(su) == lower_user) { print user ":" pass; replaced = 1; next }
            }
            print line
        }
        END { if (!replaced) exit 1 }
    ' "$USERS_FILE" > "$tmpfile" && cat "$tmpfile" > "$USERS_FILE"
    rc=$?
    rm -f "$tmpfile"
    if [ $rc -ne 0 ]; then
        echo -e "${RED}Не удалось изменить пароль${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ Пароль пользователя '${username}' изменён${NC}"
}

del_user() {
    local username="$1"

    if [ -z "$username" ]; then
        echo -e "${RED}Использование: hy2user del <username>${NC}"
        exit 1
    fi

    if ! user_exists "$username"; then
        echo -e "${RED}Пользователь '${username}' не найден${NC}"
        exit 1
    fi

    sed -i "/^${username}:/Id" "$USERS_FILE"
    echo -e "${GREEN}✓ Пользователь '${username}' удалён${NC}"
}

list_users() {
    check_users_file

    echo -e "${YELLOW}Список пользователей:${NC}"
    echo "----------------------------------------"
    printf "%-20s %s\n" "USERNAME" "PASSWORD"
    echo "----------------------------------------"

    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        username="${line%%:*}"
        password="${line#*:}"
        password="${password%$'\r'}"
        printf "%-20s %s\n" "$username" "$password"
    done < "$USERS_FILE"

    echo "----------------------------------------"
    count=$(grep -vE '^[[:space:]]*(#|$)' "$USERS_FILE" | grep -c ':' || true)
    echo -e "Всего пользователей: ${GREEN}${count}${NC}"
}

show_help() {
    cat << EOF
Управление пользователями Hysteria 2

Использование:
  hy2user add  <username> [password]   Добавить пользователя
  hy2user pass <username> [password]   Сменить пароль
  hy2user del  <username>              Удалить пользователя
  hy2user list                         Показать всех пользователей
  hy2user help                         Эта справка

Если пароль не указан — генерируется автоматически.
EOF
}

# === Main ===
case "$1" in
    add)
        check_users_file
        add_user "$2" "$3"
        ;;
    pass|change-pass|chpass)
        check_users_file
        change_pass "$2" "$3"
        ;;
    del|delete|rm)
        check_users_file
        del_user "$2"
        ;;
    list|ls)
        list_users
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}Неизвестная команда: $1${NC}"
        show_help
        exit 1
        ;;
esac
